#include <stdio.h>
#include <iostream>
using namespace std;

int main() 
{
    string s;
    int count=1;
    getline(cin,s);
    // cout<<s;
    for (int i=0;i<s.length();i++)
    {
        if (s[i]==' ')
        {
            count++;
        }
    }
    // printf("%c",s[s.length()-1]);
    if (s[0]==' ')
    {
        count--;
    }
    if (s[s.length()-1]==' ')
    {
        count--;
    }
    printf("%d",count);
    return 0;
}
