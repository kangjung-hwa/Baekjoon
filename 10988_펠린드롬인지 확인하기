#include <stdio.h>
#include <sstream>
#include <string>
#include <iostream>
using namespace std;

int main() 
{
    string s;
    cin>>s;
    int len, count = 0;
    len = s.length();
    if (len%2==0)
    {
        // printf("even");
        for (int j=0;j<len/2;j++)
        {
            if (s[j]==s[len-j-1])
            {
                count++;
                // printf("%d", count);
            }
        }
        if (count==len/2)
        {
            printf("1");
        }
        else
        {
            printf("0");
        }
    }
    else
    {
        // printf("odd");
        for (int i=0;i<(len-1)/2;i++)
        {
            if (s[i]==s[len-i-1])
            {
                count++;
            }
        }
        if (count==(len-1)/2)
        {
            printf("1");
        }
        else
        {
            printf("0");
        }
    }
    return 0;
}
